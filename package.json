        "test:e2e": "playwright test",
        "convex": "convex dev"
    },
    "dependencies": {
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@edge-runtime/vm": "^5.0.0",
        "@modelcontextprotocol/server": "^2.4.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/turbopack": "4.3.5",
        "@types/bun": "^1.4.4",
        "@types/node": "^20.19.43",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sql.js": "^1.4.11",
        "@zip.js/zip.js": "^2.25.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "convex": "^1.51.0",
        "convex-test": "^0.0.71",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.6",
        "htmlparser2": "^12.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "lucide-react": "^1.75.0",
        "mcp-handler": "^2.4.0",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn": "^4.23.0",
        "sql.js": "^1.16.0",
        "tailwindcss": "4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0",
        "zod": "^4.6.7"
    },
    "packageManager": "bun@1.4.4",
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
