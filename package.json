{
    "name": "retenio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test:anki": "bun test lib/anki.test.ts lib/import/package.test.ts lib/import/upload.test.ts",
        "format": "prettier . --write",
