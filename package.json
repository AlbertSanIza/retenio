{
    "name": "retenio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "format": "prettier . --write",
        "prepare": "husky",
        "format:swift": "bash scripts/swift-format.sh --write",
        "check:swift": "bash scripts/swift-format.sh --check",
        "check:ios": "bash scripts/check-ios.sh"
    },
    "dependencies": {
        "@types/bun": "^1.4.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1"
    },
    "lint-staged": {
        "*.swift": "bash scripts/swift-format.sh --check",
        "!(*.swift)": "prettier --check --ignore-unknown"
    }
}
