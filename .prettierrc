{
    "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-tailwindcss"],
    "printWidth": 160,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "tailwindFunctions": ["clsx", "cn", "cva", "twMerge", "tw\\.[a-z-]+"],
    "tailwindStylesheet": "./app/globals.css",
    "trailingComma": "none"
}
